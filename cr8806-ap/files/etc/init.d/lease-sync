#!/bin/sh /etc/rc.common
# Ten thiet bi cho LuCI tu DHCP lease cua router, chi client dang ket noi AP nay (xem /usr/sbin/lease-sync).

START=95
USE_PROCD=1

start_service() {
	[ -r /etc/lease-sync.conf ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/lease-sync
	procd_set_param respawn
	procd_close_instance
}
