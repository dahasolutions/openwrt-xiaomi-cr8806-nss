#!/bin/sh /etc/rc.common
# Dong bo ten thiet bi tu DHCP lease cua router (xem /usr/sbin/lease-sync), 5 phut/lan.

START=95
USE_PROCD=1

start_service() {
	[ -r /etc/lease-sync.conf ] || return 0
	procd_open_instance
	procd_set_param command /bin/sh -c 'while :; do /usr/sbin/lease-sync; sleep 300; done'
	procd_set_param respawn
	procd_close_instance
}
