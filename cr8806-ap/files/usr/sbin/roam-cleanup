#!/bin/sh
# Go client "ma" o AP cu sau khi client da roam sang AP khac.
#
# Khi client chuyen AP bang 802.11r, AP cu khong duoc bao: no van giu client ~8 s cho toi khi
# driver thay mat ACK. Trong luc do, may nao noi cung AP cu gui toi client se bi mat goi.
# Go khi du ca 3 dieu kien:
#   - usteer bao client dang ket noi o mot AP khac;
#   - o AP nay client da im lang > IDLE_MS (mac dinh 800 ms);
#   - client da ket noi o AP nay > MIN_CONN giay (mac dinh 5): khong go ket noi vua moi lap o
#     AP moi trong luc usteer con thay ban ghi cu o AP cu.
# Chi co tac dung voi SSID usteer theo doi (ssid_list); SSID khac khong co thong tin AP khac.

IDLE_MS=${IDLE_MS:-800}
MIN_CONN=${MIN_CONN:-5}

while :; do
	for obj in $(ubus list 'hostapd.*' 2>/dev/null); do
		ifc=${obj#hostapd.}
		iw dev "$ifc" station dump 2>/dev/null |
			awk -v idle="$IDLE_MS" -v conn="$MIN_CONN" \
				'/^Station/{m=$2} /inactive time/{i=$3} /connected time/{if (i > idle && $3 > conn) print m, i, $3}' |
		while read -r mac inact ct; do
			ubus call usteer get_client_info "{\"address\":\"$mac\"}" 2>/dev/null | tr -d '\t\n ' |
				grep -qE '"[0-9a-fA-F.:]+#hostapd\.[^"]*":\{"connected":true' || continue
			ubus call "$obj" del_client "{\"addr\":\"$mac\",\"reason\":5,\"deauth\":true,\"ban_time\":0}" >/dev/null 2>&1
			# hostapd cho trang thai gui deauth roi moi xoa khoi kernel (~2 s); xoa ngay
			iw dev "$ifc" station del "$mac" 2>/dev/null
			logger -t roam-cleanup "$ifc: go $mac (im lang ${inact}ms, ket noi ${ct}s, client da o AP khac)"
		done
	done
	sleep 1
done
