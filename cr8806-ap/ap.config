# Xiaomi CR8806 (M79) - ban AP thuan (dumb AP) co NSS offload.
# Ghep tu .github/ci/ipq50xx/common.config + 256m.config, chi build CR8806, bo cac goi chi router
# moi can, them wpad day du (802.11k/v/r) va usteer.
# Kernel: CONFIG_BPF_JIT tat trong target/linux/qualcommax/ipq50xx/config-default (~2 MiB).

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_cr8806=y
# Image chay tren RAM de thu truoc khi ghi flash (tftpboot qua UART)
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- NSS: wired plane + ECM + Wi-Fi offload (giong common.config) ---
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y

# --- 256 MB RAM (giong 256m.config; ATH11K_NSS_MEM_PROFILE_256M mac dinh bat cho CR8806) ---
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_NSS_MEM_PROFILE_LOW=y

# --- Bo: SQM / shaper / IGS (chi router can) ---
# CONFIG_NSS_DRV_SHAPER_ENABLE is not set
# CONFIG_NSS_DRV_IGS_ENABLE is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-igs is not set
# CONFIG_PACKAGE_sqm-scripts is not set
# CONFIG_PACKAGE_sqm-scripts-nss is not set
# CONFIG_PACKAGE_tc-full is not set
# CONFIG_PACKAGE_kmod-sched-cake is not set
# CONFIG_PACKAGE_kmod-ifb is not set

# --- Bo: PPPoE phia userspace, DHCP/RA server ---
# kmod-ppp/kmod-pppoe va kmod-nf-conntrack la phu thuoc cung cua qca-nss-ecm nen van con.
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe is not set
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set

# firewall4 GIU LAI: ECM theo doi luong qua conntrack; bridged offload tren AP da duoc kiem
# chung khi co firewall (README.ipq50xx.md). Bo firewall la buoc thu sau, khong lam o ban nay.

# --- Bo: USB (CR8806 khong co cong USB, DTS khong co node usb), cong cu ext4 ---
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_e2fsprogs is not set

# --- Bo: debug ath11k va cong cu chan doan (iperf3 build thanh goi rieng) ---
# CONFIG_PACKAGE_ATH_DEBUG is not set
CONFIG_PACKAGE_iperf3=m
# CONFIG_PACKAGE_dumpimage is not set

# --- Wi-Fi: wpad day du thay ban basic (802.11k/v/r) + usteer dieu phoi client giua cac AP ---
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_usteer=y

# --- RAM: swap nen trong RAM, CPU ranh vi NSS lo phan chuyen goi ---
CONFIG_PACKAGE_zram-swap=y

# --- LuCI tung phan (luci-light keo theo luci-app-firewall, luci-proto-ppp) ---
# Tat sau khi setup xong de lay lai RAM: /etc/init.d/uhttpd disable; /etc/init.d/rpcd disable
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# --- Build ---
CONFIG_KERNEL_BUILD_DOMAIN="openwrt-nss-edma"
CONFIG_KERNEL_BUILD_USER="cr8806-ap"
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=y
# CONFIG_KERNEL_DEBUG_INFO is not set
